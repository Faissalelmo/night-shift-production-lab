# Fast schedules for demos and video recording: `cp .env.demo.example .env`
# then `docker compose up -d` (or `make up`). Same behaviour, every timer ~5x shorter:
# the "silent stop" alert fires ~3-4 min after `make inject SCENARIO=missing_file`
# instead of ~15-20 min.

POSTGRES_USER=lab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payments
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

IMPORT_EVERY_MIN=1
RECONCILE_EVERY_MIN=2
EXTRACT_EVERY_MIN=3
GENERATOR_EVERY_SECONDS=30
SYNTHETIC_EVERY_SECONDS=60
RECON_GRACE_MINUTES=5
