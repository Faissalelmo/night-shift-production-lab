# Copy to .env and adjust. Every variable has a default in docker-compose.yml,
# so the lab also starts without this file. Never commit .env.

# --- credentials (local lab only; ports are bound to 127.0.0.1)
POSTGRES_USER=lab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payments
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- schedules (production-like)
IMPORT_EVERY_MIN=5          # import_settlement_file
RECONCILE_EVERY_MIN=10      # reconcile_transactions
EXTRACT_EVERY_MIN=15        # daily_extract ("daily", compressed)
GENERATOR_EVERY_SECONDS=120 # a new settlement file every 2 min
SYNTHETIC_EVERY_SECONDS=300 # synthetic check every 5 min
RECON_GRACE_MINUTES=30      # unsettled transactions flagged after 30 min

# --- host ports
GRAFANA_PORT=3000
KIBANA_PORT=5601
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
STATUS_PORT=8088
ES_PORT=9200
POSTGRES_PORT=55432
